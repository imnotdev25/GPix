# gpix environment variables.
# Copy this file to .env (in Docker: ./data/.env) and fill in what you need.
#
# gpix reads .env on startup; variables already set in the real environment win.
# All settings come from the environment; gpix-web.conf is no longer read.
#
# Leave optional lines commented out: an uncommented empty GPIX_* value replaces
# the default with an empty one.
# Don't put comments at the end of a value line; they'd become part of the value.

# ---- Google Photos account (required) ------------------------------------------
# Scraped from the Google Photos Android app; see "Auth" in the README.
# Seeds the first linked account; more can be linked later from the web UI.
# Format: androidId=...&app=com.google.android.apps.photos&...&Token=aas_et/...
GP_AUTH_DATA=

# ---- Web UI ---------------------------------------------------------------------
# Address the web UI listens on (default 0.0.0.0:8080).
# GPIX_LISTEN=0.0.0.0:8080

# ---- Accounts ------------------------------------------------------------------
# No login is needed in this file: the first visitor creates an account in the
# web UI. Sign-up stays open until this many accounts exist (default 1; 0 = no
# limit), for both password sign-up and single sign-on.
# GPIX_MAX_USERS=1
# Who may sign up: comma-separated emails and/or @domains. Empty = anyone.
# GPIX_SIGNUP_ALLOWLIST=you@example.com,@example.com

# Older setups: a username + bcrypt hash (from `gpix -hashpw`) here is imported
# once as an account, after which both lines can be removed. Keep the single
# quotes: the hash contains "$".
# GPIX_USERNAME=you
# GPIX_PASSWORD_HASH='$2a$12$replace_me'

# Turn off the username/password form (e.g. when only single sign-on is used).
# GPIX_DISABLE_PASSWORD_LOGIN=false

# Public base URL, used to build absolute share links and the SSO callback.
# SERVER_URL=https://photos.example.com
# GPIX_SERVER_URL is accepted too; SERVER_URL wins when both are set.
# GPIX_SERVER_URL=

# Where runtime state lives (secret.key, *.db, gateways.json, encryption.key,
# rendered thumbnails). Default: the working directory.
# GPIX_DATA_DIR=

# Temp directory for uploads in progress (default: the OS temp directory).
# GPIX_TEMP_DIR=

# Device profile gpix presents to Google: pixel-xl (default) or pixel-5.
# GPIX_DEVICE_PROFILE=pixel-xl

# Uploads processed at the same time (default 2).
# GPIX_MAX_CONCURRENT_UPLOADS=2

# How long a sign-in lasts, in days (default 30).
# GPIX_SESSION_DAYS=30

# Lifetime of signed video-stream and download links, in minutes (default 60).
# GPIX_STREAM_TOKEN_TTL_MIN=60

# Encrypt new uploads with the gpix-managed key (first run only; afterwards the
# toggle in the web UI is what counts).
# GPIX_ENCRYPT_UPLOADS=false

# Render thumbnails locally for encrypted/disguised items (Google only has a
# blank one for them). Set to false to save CPU; thumbnails already rendered
# are still served, and new encrypted items show a placeholder.
# GPIX_THUMB_GEN=true

# ---- S3-compatible gateway (off unless GPIX_S3_LISTEN is set) -------------------
# GPIX_S3_LISTEN=0.0.0.0:9000
# GPIX_S3_BUCKET=gpix
# GPIX_S3_REGION=us-east-1
# Optional fixed keys; usually you generate and rotate them in the web UI instead.
# GPIX_S3_ACCESS_KEY=
# GPIX_S3_SECRET_KEY=

# ---- WebDAV gateway (off unless GPIX_WEBDAV_LISTEN is set) ----------------------
# GPIX_WEBDAV_LISTEN=0.0.0.0:8081
# GPIX_WEBDAV_BASE_PATH=/

# ---- Single sign-on: Logto / OIDC (on when endpoint, client id and secret are set)
# GPIX_LOGTO_ENDPOINT=https://your-tenant.logto.app/oidc
# GPIX_LOGTO_CLIENT_ID=
# GPIX_LOGTO_CLIENT_SECRET=
# Callback URL; defaults to SERVER_URL + /auth/logto/callback.
# GPIX_LOGTO_REDIRECT=
# Single sign-on follows GPIX_MAX_USERS and GPIX_SIGNUP_ALLOWLIST above.

# ---- Telegram bot (off by default) ------------------------------------------------
# The bot only starts when this is true AND gpix runs with -mode all or -mode bot.
TG_BOT_ENABLED=false
# Token from @BotFather.
TG_BOT_TOKEN=
# api_id + api_hash from https://my.telegram.org/apps
TG_API_ID=
TG_API_HASH=
# Your own Telegram user id (DM @userinfobot to find it); only you can use the bot.
TG_OWNER_ID=
# Optional bot settings (defaults: gpixbot.session, the OS temp dir, 2).
TG_SESSION_FILE=gpixbot.session
TG_TEMP_DIR=
TG_MAX_CONCURRENT=2

# ---- Logging ------------------------------------------------------------------------
# debug | info (default) | warn | error. The -log flag wins when given.
# At debug, every request is logged; at info, sign-ins, changes, errors and
# slow requests are. Share and signed-link tokens are shortened in the log.
# GPIX_LOG_LEVEL=info
# text (default) or json (one JSON object per line, for log collectors).
# GPIX_LOG_FORMAT=text

# ---- Network (optional) -----------------------------------------------------------
# Standard proxy variables, honored for outbound connections to Google.
# HTTPS_PROXY=http://proxy.example.com:3128
# NO_PROXY=localhost,127.0.0.1
